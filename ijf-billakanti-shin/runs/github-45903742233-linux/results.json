  "environment_commands": [
   {
    "id": "tools",
    "cmd": "uv --version; pdftoppm -v 2>&1 | head -1; nproc; free -g | head -2; program_v04/.venv/bin/python -c 'import sys,numpy,sklearn,xgboost;print(sys.version);print(numpy.__version__,sklearn.__version__,xgboost.__version__)' || true"
   }
  ],
  "setup": [
   {
    "id": "install_tools",
