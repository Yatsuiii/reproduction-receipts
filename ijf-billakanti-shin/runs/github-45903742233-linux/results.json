    "timeout_s": 900
   },
   {
    "id": "uv_sync",
    "cmd": "cd program_v04 && uv sync --locked && cd .. && uv pip install --python program_v04/.venv/bin/python xlrd==2.0.2",
    "timeout_s": 1800
   },
   {
    "id": "download_inputs",
    "cmd": "program_v04/.venv/bin/python scripts/download_inputs.py && program_v04/.venv/bin/python scripts/verify_inputs.py",
    "timeout_s": 1800
   }
  ],
  "commands": [
   {
    "id": "run_main",
    "cmd": "cd program_v04 && .venv/bin/python -m program_v04.main.run_main --input-mode public",
    "timeout_s": 16200,
    "outputs": []
   },
   {
    "id": "place_main_tables_for_comparison",
    "cmd": "cp program_v04/output/main/tables/*.csv reference/output/main/tables/",
    "timeout_s": 60,
    "outputs": [
     "reference/output/main/tables/table01_single_binary_summary.csv",
     "reference/output/main/tables/table02_zt_vs_benchmarks.csv",
     "reference/output/main/tables/table03_aggregation_comparison.csv",
