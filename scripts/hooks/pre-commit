#!/bin/sh
# Blocks commits that change frozen triage fixtures or agent-receipts injections without updating their FROZEN.json.
# Install for this repo: git config core.hooksPath scripts/hooks
top=$(git rev-parse --show-toplevel) || exit 1
python3 "$top/triage/check_frozen.py" || exit 1
python3 "$top/agent-receipts/check_frozen.py" || exit 1
